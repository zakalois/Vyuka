@page "/Admin/Hours"
@model Vyuka.Pages.Admin.HoursModel

<h1>Přehled hodin celkem</h1>

<!-- MĚSÍČNÍ FILTR -->
@if (Model.SelectedStudentId != null)
{
    var currentOffset = Request.Query["monthOffset"].Count == 0
        ? 0
        : int.Parse(Request.Query["monthOffset"]);

    <div class="mb-3">

        <a href="/Admin/Hours?studentId=@Model.SelectedStudentId&monthOffset=0"
           class="btn btn-outline-secondary me-2">
            Tento měsíc
        </a>

        <a href="/Admin/Hours?studentId=@Model.SelectedStudentId&monthOffset=@(currentOffset - 1)"
           class="btn btn-outline-dark">
            ← Předchozí měsíc
        </a>

    </div>
}

<!-- HORNÍ PŘEHLED – stejné barvy jako Platby -->
<div class="row mb-4">

    <div class="col-md-4">
        <div class="alert alert-info text-center">
            <strong>Předplacené hodiny</strong><br />
            @Model.TotalPrepaidHours.ToString("0")
        </div>
    </div>

    <div class="col-md-4">
        <div class="alert alert-success text-center">
            <strong>Odučené hodiny</strong><br />
            @Model.TotalTaughtHours.ToString("0")
        </div>
    </div>

    <div class="col-md-4">
        <div class="alert alert-warning text-center">
            <strong>Zbývá odučit hodin</strong><br />
            @Model.TotalRemainingHours.ToString("0")
        </div>
    </div>

</div>

<!-- FILTR -->
<form method="get" class="mb-4">
    <div class="row g-3 align-items-end">

        <div class="col-md-4">
            <label class="form-label">Vyber studenta:</label>
            <select name="studentId" class="form-select">
                <option value="">Vyber studenta</option>
                @foreach (var s in Model.Students)
                {
                    <option value="@s.Id" selected="@(Model.SelectedStudentId == s.Id)">
                        @s.LastName @s.FirstName
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Od:</label>
            <input type="date" name="from" class="form-control"
                   value="@(Model.From.HasValue ? Model.From.Value.ToString("yyyy-MM-dd") : "")" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Do:</label>
            <input type="date" name="to" class="form-control"
                   value="@(Model.To.HasValue ? Model.To.Value.ToString("yyyy-MM-dd") : "")" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filtrovat</button>
        </div>

    </div>
</form>

@if (Model.SelectedStudent != null)
{
    <h3>@Model.SelectedStudent.LastName @Model.SelectedStudent.FirstName</h3>

    <!-- CELKOVÝ SOUHRN STUDENTA – stejné alert barvy -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="alert alert-info text-center">
                <strong>Zaplaceno hodin</strong><br />
                @Model.PaidHours.ToString("0")
            </div>
        </div>

        <div class="col-md-3">
            <div class="alert alert-warning text-center">
                <strong>Plánované hodiny v intervalu</strong><br />
                @Model.PlannedHours.ToString("0")
            </div>
        </div>

        <div class="col-md-3">
            <div class="alert alert-success text-center">
                <strong>Odučené hodiny v intervalu</strong><br />
                @Model.TaughtHours.ToString("0")
            </div>
        </div>

        <div class="col-md-3">
            <div class="alert alert-danger text-center">
                <strong>Zbývá odučit hodin celkem</strong><br />
                @Model.RemainingHours.ToString("0")
            </div>
        </div>

    </div>

    <!-- DALŠÍ PLÁNOVANÁ HODINA -->
    @if (Model.NextLesson != null)
    {
        <div class="alert alert-info text-center" style="border: 2px solid #0dcaf0;">
            <strong>Další plánovaná hodina:</strong><br />
            @Model.NextLesson.Date.ToString("dd.MM.yyyy")
            @Model.NextLesson.Start.ToString(@"hh\:mm")
            –
            @Model.NextLesson.End.ToString(@"hh\:mm")
            (@((Model.NextLesson.End - Model.NextLesson.Start).TotalHours.ToString("0")))
        </div>
    }

    <!-- SOUHRN ZA OBDOBÍ – jen když existují hodiny -->
    @if (Model.IntervalLessonsCount > 0)
    {
        <div class="row mb-3">

            <div class="col-md-4">
                <div class="alert alert-info text-center">
                    <strong>Odučené hodiny v období</strong><br />
                    @Model.IntervalTaughtHours.ToString("0")
                </div>
            </div>

            <div class="col-md-4">
                <div class="alert alert-success text-center">
                    <strong>Počet lekcí v období</strong><br />
                    @Model.IntervalLessonsCount
                </div>
            </div>

            <div class="col-md-4">
                <div class="alert alert-primary text-center">
                    <strong>Celkem odučeno hodin</strong><br />
                    @Model.TotalTaughtStudentHours.ToString("0")
                </div>
            </div>

        </div>
    }

    <!-- TABULKA -->
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Od</th>
                <th>Do</th>
                <th>Hodin</th>
                <th>Typ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.UnifiedLessons)
            {
                var css = l.IsTaught ? "table-success" : "table-warning";

                <tr class="@css">
                    <td>@l.Date.ToString("dd.MM.yyyy")</td>
                    <td>@l.Start.ToString(@"hh\:mm")</td>
                    <td>@l.End.ToString(@"hh\:mm")</td>
                    <td>@((l.End - l.Start).TotalHours.ToString("0"))</td>
                    <td>@(l.IsTaught ? "Odučeno" : "Plánováno")</td>
                </tr>
            }
        </tbody>
    </table>
}
